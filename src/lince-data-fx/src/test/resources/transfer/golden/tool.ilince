        <void property="codigo">
         <string>PREPARACIÓN</string>
        </void>
        <void property="descripcion">
         <string>Se inicia en el momento en el que la nadadora deja de avanzar y termina cuando empieza el acompañamiento musical. </string>
        </void>
        <void property="nombre">
         <string>PREPARACIÓN</string>
        </void>
       </object>
      </void>
      <void method="add">
       <object class="lince.modelo.InstrumentoObservacional.Categoria">
        <void property="codigo">
         <string>RUTINA</string>
        </void>
        <void property="descripcion">
