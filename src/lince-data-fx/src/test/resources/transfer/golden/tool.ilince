      <void method="add">
       <object class="lince.modelo.InstrumentoObservacional.Categoria">
        <void property="codigo">
         <string>DPRE RUTINA</string>
        </void>
        <void property="descripcion">
         <string>Desplazamiento que realiza la nadadora desde la zona de salida hasta el punto donde iniciará la rutina. Empieza con el primer movimiento de desplazamiento y finaliza en el instante en que la nadadora deja de avanzar.</string>
        </void>
        <void property="nombre">
         <string>DESPLAZAMIENTO PRE RUTINA</string>
        </void>
       </object>
      </void>
      <void method="add">
