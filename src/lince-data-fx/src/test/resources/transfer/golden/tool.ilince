        </void>
        <void property="nombre">
         <string>RUTINA</string>
        </void>
       </object>
      </void>
      <void method="add">
       <object class="lince.modelo.InstrumentoObservacional.Categoria">
        <void property="codigo">
         <string>DPOST RUTINA</string>
        </void>
        <void property="descripcion">
         <string>Engloba desde el momento en el que termina el acompañamiento musical hasta que la nadadora apoya los dos pies en la playa de la piscina. </string>
        </void>
        <void property="nombre">
         <string>DESPLAZAMIENTO POST RUTINA</string>
        </void>
       </object>
      </void>
