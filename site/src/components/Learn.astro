---
import learn from '../data/learn.json';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<section id="learn" class="section-tight learn" data-section="learn">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t('learn.eyebrow')}</span>
      <h2>{t('learn.title')}</h2>
    </div>
    <div class="grid">
      {learn.map((l, i) => (
        <article class="card">
          <h3>{l.title[locale]}</h3>
          <p>{l.body[locale]}</p>
          <div class="links">
            <a class="btn btn-outline btn-sm" href={l.url} rel="noopener" target="_blank" data-ga={`learn-${i}`}>
              {l.cta[locale]}
            </a>
            {'alt' in l && l.alt && (
              <a class="alt" href={l.alt.url} rel="noopener" target="_blank" data-ga={`learn-${i}-alt`}>
                {l.alt.label[locale]}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .learn {
    border-top: 1px solid var(--border-2);
    border-bottom: 1px solid var(--border-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
  }
  .card p {
    font-size: 0.92rem;
    flex: 1;
  }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .links .btn {
    width: auto;
  }
  .alt {
    font-size: 0.88rem;
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
