---
import learn from '../data/learn.json';
---

<section id="learn" class="section-tight learn">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Learn</span>
      <h2>Guides, Videos And Workshops.</h2>
    </div>
    <div class="grid">
      {learn.map((l) => (
        <article class="card">
          <h3>{l.title}</h3>
          <p>{l.body}</p>
          <div class="links">
            <a class="btn btn-outline btn-sm" href={l.url} rel="noopener" target="_blank">{l.cta}</a>
            {l.alt && (
              <a class="alt" href={l.alt.url} rel="noopener" target="_blank">{l.alt.label}</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .learn {
    border-top: 1px solid var(--border-2);
    border-bottom: 1px solid var(--border-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
  }
  .card p {
    font-size: 0.92rem;
    flex: 1;
  }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .links .btn {
    width: auto;
  }
  .alt {
    font-size: 0.88rem;
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
