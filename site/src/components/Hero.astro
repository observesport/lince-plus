---
import { RELEASE_URL, VERSION, href } from '../lib/site';
import { getLocale, localePath, useTranslations } from '../i18n';

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<section class="hero" data-section="hero">
  <div class="container hero-grid">
    <div class="copy">
      <span class="eyebrow">{t('hero.eyebrow', { version: VERSION })}</span>
      <h1>{t('hero.title')}</h1>
      <p class="lede">{t('hero.lede')}</p>
      <div class="cta-row">
        <a class="btn btn-teal" href={localePath(locale, '/#install')} data-ga="hero-download">
          {t('hero.download', { version: VERSION })}
        </a>
        <a class="btn btn-outline" href={RELEASE_URL} rel="noopener" target="_blank" data-ga="hero-release-notes">
          {t('hero.notes')}
        </a>
      </div>
      <ul class="facts">
        <li><span class="dot ok"></span>{t('hero.fact1')}</li>
        <li><span class="dot"></span>{t('hero.fact2')}</li>
        <li><span class="dot"></span>{t('hero.fact3')}</li>
      </ul>
    </div>

    <figure class="visual">
      <img
        src={href('/img/ai-studio-player.png')}
        alt={t('hero.imageAlt')}
        width="792"
        height="531"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span class="chip chip-teal">{t('hero.chipPose')}</span>
        <span class="chip">{t('hero.chipAngles')}</span>
        <span class="chip">{t('hero.chip3d')}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 88px 0 72px;
    border-bottom: 1px solid var(--border-2);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 56px;
    align-items: center;
  }
  .copy .lede {
    font-size: 1.1rem;
    max-width: 54ch;
    margin-bottom: 2rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: var(--fg-2);
    font-size: 0.92rem;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal-400);
    flex-shrink: 0;
  }
  .dot.ok {
    background: var(--status-ok);
  }
  .visual {
    margin: 0;
  }
  .visual img {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: var(--bg-3);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    justify-content: center;
  }
  @media (max-width: 960px) {
    .hero {
      padding: 56px 0 48px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
</style>
