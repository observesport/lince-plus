---
import { href } from '../lib/site';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<section class="section-tight sponsors" data-section="sponsors">
  <div class="container">
    <p class="label">{t('sponsors.label')}</p>
    <ul class="logos">
      <li>
        <a class="funding-logo" href="https://www.aei.gob.es/" rel="noopener" target="_blank" data-ga="sponsor-aei">
          <img
            src={href('/img/funding/miciu-aei.png')}
            alt={t('sponsors.fundingLogoAlt')}
            width="1558"
            height="700"
            loading="lazy"
          />
        </a>
      </li>
      <li>
        <a
          href="https://www.ej-technologies.com/products/install4j/overview.html"
          rel="noopener"
          target="_blank"
          aria-label="install4j"
          data-ga="sponsor-install4j"
        >
          <img class="install4j" src={href('/img/sponsors/install4j.png')} alt="install4j" width="120" height="34" loading="lazy" />
        </a>
      </li>
    </ul>
    <p class="reference">{t('sponsors.funding')}</p>
    <p class="note">{t('sponsors.note')}</p>
  </div>
</section>

<style>
  .sponsors {
    text-align: center;
    border-top: 1px solid var(--border-2);
  }
  .label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 24px;
  }
  .logos {
    list-style: none;
    margin: 0 auto 24px;
    padding: 0;
    max-width: 760px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    justify-items: center;
    gap: 32px 48px;
  }
  .funding-logo {
    display: block;
    background: #ffffff;
    padding: 12px 16px;
    border-radius: 8px;
    max-width: 100%;
  }
  .funding-logo img {
    display: block;
    width: 320px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1558 / 700;
    object-fit: contain;
  }
  .install4j {
    opacity: 0.85;
  }
  a:hover .install4j {
    opacity: 1;
  }
  .reference {
    color: var(--fg-2);
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 90ch;
    margin: 0 auto 12px;
  }
  .note {
    color: var(--fg-3);
    font-size: 0.85rem;
    margin: 0;
  }
  @media (max-width: 620px) {
    .logos {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
