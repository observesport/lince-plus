---
import citations from '../data/citations.json';
---

<section id="research" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Research</span>
      <h2>Cite LINCE PLUS In Your Work.</h2>
      <p class="lede">
        LINCE PLUS is developed through doctoral research with INEFC Catalunya.
        If it supports a study, please cite the most relevant paper.
      </p>
    </div>
    <ol class="citations">
      {citations.map((c) => (
        <li class="card">
          <span class="year mono">{c.year}</span>
          <div>
            <h3>{c.title}</h3>
            <p class="authors">{c.authors}</p>
            <p class="meta"><em>{c.journal}</em>, {c.details}</p>
            <a class="mono" href={c.url} rel="noopener" target="_blank">doi:{c.doi}</a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .citations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .citations li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    align-items: start;
  }
  .year {
    display: inline-flex;
    justify-content: center;
    padding: 4px 0;
    border-radius: var(--radius-pill);
    background: var(--teal-400);
    color: var(--fg-on-teal);
    font-weight: 500;
    font-size: 0.85rem;
  }
  h3 {
    margin-bottom: 6px;
  }
  .authors {
    color: var(--fg-1);
    font-size: 0.95rem;
    margin-bottom: 4px;
  }
  .meta {
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  .citations a {
    font-size: 0.85rem;
    word-break: break-all;
  }
  @media (max-width: 520px) {
    .citations li {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .year {
      width: 72px;
    }
  }
</style>
